node_modules/
dist/
.env
# Every env variant is a secrets file. `.env` alone did not cover .env.prod,
# .env.local, .env.staging — a filled deployment env was committable until
# this rule existed. The example file is the ONE exception: it holds variable
# names and generation commands, never values.
.env.*
!.env.example
*.tsbuildinfo
coverage/
.next/
.pglite/
tmp/
invoices/
# artifacts/ is generated EXCEPT the committed M1b live-eval evidence, which
# estimate-m1b-regression.test.ts replays (projection must dominate actuals).
/artifacts/*
!/artifacts/m1b-gate3-live.log
!/artifacts/m1b-sweep.log
# ...and the tenancy classification exhibit, which tenancy-report.test.ts
# reads and compares against what the committed inventories render. Its own
# header called it "the committed classification exhibit" while /artifacts/*
# swallowed it, so it existed only on machines that had generated it — the
# test passed locally and could not pass in a clean checkout at all. Found by
# CI's first run that got far enough to reach it (2026-09-08).
!/artifacts/tenancy-classification.md
# ...and the Step 12 target register, for the same reason and more sharply:
# step12-targets.test.ts exists so a row "cannot close by silence, by prose,
# or by deletion" — and /artifacts/* had deleted the whole register from the
# repo. The guard against disappearance had itself disappeared, and the test
# passed only where a copy happened to sit on disk (2026-09-08).
!/artifacts/step-12-targets.json
!/artifacts/m1b-sweep-2026-08-06T05-16-58-387Z.json
# G2.8 capstone exhibits: the parameter report is the item's deliverable, and
# the findings JSON is the machine-readable record of the live run (clusters,
# suite sizes, retention verdict, per-leg spend). The raw leg logs stay
# ignored — reproducible, and the ledger carries their numbers.
!/artifacts/g28-parameters.md
# G2.4 tenancy classification: tenancy-report.test.ts reads THIS FILE and
# asserts it matches the route + mock-eligibility inventories, so a fixture
# change without a regeneration fails there instead of shipping a stale
# security answer. While it stayed ignored the test threw ENOENT on any clean
# checkout — it only ever passed on machines that happened to have a local
# copy, which is to say it never guarded CI at all (found 2026-09-04, the
# first time the suite was run on a clean tree). Regenerate with:
#   pnpm --filter @potion/server tenancy-report
!/artifacts/tenancy-classification.md
# Step 12 adversarial target register: step12-targets.test.ts calls this "a
# committed artifact" and exists to stop rows vanishing ("a row cannot close
# by silence, by prose, or by deletion") — but it was ignored, so NOTHING
# generates it, no clone has it, and the test that guards it threw ENOENT on
# every clean checkout. A hand-authored security register that lived on one
# laptop (found 2026-09-04).
!/artifacts/step-12-targets.json
!/artifacts/g28-capstone-live.json

# campaign run logs are records, not source
.tranche/*.log

# coverage output (P1.4) — the ratchet reads it, git does not carry it
coverage-artifacts/

# HEAD-TO-HEAD RESULTS ARE EVIDENCE, NOT BUILD OUTPUT (2026-09-17). The
# 2026-09-07 head-to-head lived outside the repo and is gone; these dated
# runs and their README stay with the script that produced them.
!/artifacts/head-to-head/
!/artifacts/head-to-head/**

# Jev (TypeSafe) trials — 2026-09-17, scripts/jev-trial.mjs
!/artifacts/jev-trial/
!/artifacts/jev-trial/**
