# Potion deployment environment — NAMES AND GENERATION COMMANDS ONLY.
#
# Copy to .env.prod, fill in, then: chown root .env.prod && chmod 600 .env.prod
# .env* is gitignored. NEVER commit a filled copy, and never bake these into
# the image — they are supplied at run time via `--env-file`.

# ---- Front door ------------------------------------------------------------
# Hostname in production (Caddy auto-provisions TLS). Use `:443` for the local
# rehearsal, where Caddy issues an internal self-signed cert instead.
# Two vhosts (deploy plan D2): SDK traffic vs browser traffic.
POTION_API_SITE=api.potion.example.com
POTION_APP_SITE=app.potion.example.com
POTION_ROOT_SITE=potion.example.com
# Public API origin — docs snippets and OAuth callbacks derive from it.
POTION_APP_URL=https://app.potion.example.com
POTION_PUBLIC_URL=https://api.potion.example.com
# Loopback serving URL for the in-process worker (lab:run throws if unset).
POTION_SERVING_URL=http://localhost:3000
# Sentry error reporting (13a §1.6). Unset → init is a no-op.
SENTRY_DSN=

# ---- Database (Neon) -------------------------------------------------------
# MUST be PostgreSQL >= 15 WITH pgvector:
#   · migration 0023 uses `NULLS NOT DISTINCT`  → PG15+ only
#   · migration 0000 does `CREATE EXTENSION vector` → the app role must be
#     allowed to create it
# Verified against 17.10 + pgvector 0.8.6 (docs/REHEARSAL-COVERAGE.md).
#
# Use Neon's DIRECT endpoint, not `-pooler`: one instance with a pool of 10
# gains nothing from PgBouncer, and transaction-mode pooling is a divergence
# nothing here has tested. sslmode=require is mandatory.
DATABASE_URL=postgres://USER:PASS@ep-xxxx.REGION.aws.neon.tech/potion?sslmode=require

# Neon autosuspend cold-starts collide with /readyz's 2s db-ping timeout —
# see DEPLOY-RUNBOOK §1. Prefer disabling scale-to-zero for a partner-facing
# deployment; these are the knobs if you do not.
PG_CONN_TIMEOUT_MS=15000
PG_POOL_MAX=10

# ---- Secrets ---------------------------------------------------------------
# Encrypts stored BYOK provider keys. IF THIS IS LOST, EVERY STORED PROVIDER
# KEY IS UNRECOVERABLE. Back it up SEPARATELY from database dumps — a dump
# plus this key together is full custody compromise.
#   openssl rand -hex 32
POTION_MASTER_KEY=

# Guards the /operator/* surface. FAIL-CLOSED: unset ⇒ every operator call
# 401s and no partner org can be created. Compared timing-safely.
#   openssl rand -hex 32
POTION_OPERATOR_TOKEN=

# ---- Embedder + clustering -------------------------------------------------
# G0.5 TRAP: the default clustering threshold (0.62) is MOCK-TUNED. With a real
# embedder it must be 0.2 or agent clustering silently misbehaves — the
# walkthrough prints this warning on every run.
POTION_EMBEDDER=openai
POTION_CLUSTER_THRESHOLD=0.2

# ---- Provider keys ---------------------------------------------------------
# Partner BYOK (stored encrypted, per-org) is preferred. Platform-level keys
# below are only for platform work (research cycles, calibration).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ---- Resilience (F19) ------------------------------------------------------
# Circuit breaker, per (provider, model). Counts REQUESTS, not attempts, and
# deliberately ignores client_4xx/auth — a bad key is not a provider outage,
# and counting it would let one tenant's misconfiguration open the breaker for
# everyone. Defaults: 5 failures / 30s cooldown / 2 half-open probes.
# `off` is the escape hatch if the breaker ever opens spuriously — it was
# only ever described in this paragraph, never declared, so it did not exist
# as far as any inventory of this file was concerned (found by P2).
POTION_BREAKER=
POTION_BREAKER_THRESHOLD=5
POTION_BREAKER_COOLDOWN_MS=30000
POTION_BREAKER_PROBES=2

# ---- Observability ---------------------------------------------------------
# 1 = /metrics exists (blocked at the public listener by deploy/Caddyfile).
# 0 = the meter and the route do not exist at all — prefer this until a
#     scraper is actually deployed.
POTION_METRICS=0

# ---- Self-serve signup (default OFF) ---------------------------------------
# Unset/0 = operator onboarding (docs/ONBOARDING-RUNBOOK.md) is the only way an
# org comes into being; unknown emails get a neutral response and no org.
# 1 = any email that hits POST /auth/request-link is auto-provisioned into a
# new solo org as admin.
POTION_SELF_SERVE=
#
# There is NO SMTP in this build (honest-stub convention). With self-serve ON
# the signup succeeds but the magic link only reaches the SERVER LOG, so the
# person signing up can never actually sign in. Set this to 1 to return the
# link in the signup response and close the loop.
#
# Set both ONLY on a private/test deployment: together they let anyone who can
# reach the endpoint mint a session for any email they type. Real SMTP retires
# this flag.
POTION_MAGIC_LINK_IN_RESPONSE=

# ---- Platform frontier baseline (default ON for deployments) ---------------
# 1 = on first boot, import the live-provenance PLATFORM frontiers measured by
# the Step 5 sweep for any cluster that has none. Without it a fresh database
# has NO live platform frontier: the provenance guard discards the mock demo
# seed under a live server, and every request from every org falls through to
# the default strategy (x-frontier-trace shows fallback=1). It is idempotent
# and never clobbers a frontier this deployment already has.
POTION_PLATFORM_BASELINE=1

# ---- Magic-link email (Resend) ----
RESEND_API_KEY=
POTION_EMAIL_REPLY_TO=founder@potion.example.com
POTION_EMAIL_FROM=Potion <sign-in@potion.example.com>

# ============================================================================
# Everything below was READ BY THE CODE AND UNDOCUMENTED until 2026-09-06.
# The gap was 71 flags, among them STRIPE_SECRET_KEY, REDIS_URL and
# POTION_DEV_AUTH — whether real money can move, whether the rate limiter
# spans replicas, and whether /api/* requires authentication at all.
# scripts/env-inventory.test.ts now fails if a flag is read and not named here
# (or declared internal there, with a reason). ALL OF THESE HAVE DEFAULTS —
# a blank .env.prod still boots; they are here so the knobs are visible.
# ============================================================================

# ---- Queue and the worker split (P1-3) -------------------------------------
# The queue driver: explicit QUEUE_DRIVER > REDIS_URL present > memory.
# REDIS_URL also decides whether the rate limiter spans replicas (F18) —
# without it the limiter is per process and every contracted rate is N×.
REDIS_URL=
QUEUE_DRIVER=
# Where job handlers run. Unset/empty = IN THE SERVER PROCESS, which is right
# on one box. `off` = this server enqueues and never consumes; start the
# `worker` service (`docker compose --profile split up -d worker`) or jobs
# pile up in Redis unseen. `off` with the memory driver refuses to boot.
POTION_WORKER=

# ---- Artifact store --------------------------------------------------------
# Harness/sweep JSON. Unset = artifacts are not written at all.
# local → ARTIFACT_DIR; s3 → the S3_* block (MinIO-compatible).
ARTIFACT_STORE=
ARTIFACT_DIR=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Payments (real money) -------------------------------------------------
# Unset = the LEDGER transport: charges are recorded and never collected.
# Set = Stripe can take real money. The boot report says which is in force,
# and warns loudly if the key is present but EMPTY (silent ledger fallback).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where the billing CLI keeps its state. Default 'json-file'.
POTION_BILLING_BACKEND=

# ---- Authentication --------------------------------------------------------
# THE DEV BYPASS. When on, an UNAUTHENTICATED /api/* request resolves to the
# default org as ADMIN. Leave it unset in production: since P1-2 the default
# is an allow-list (on only for NODE_ENV development/test), so an unset or
# misspelled NODE_ENV no longer opens it — and setting this to 1 while
# NODE_ENV is production REFUSES TO BOOT.
POTION_DEV_AUTH=
# Sign in with Google. A PAIR: half a pair means the button silently never
# appears, which the boot report calls out by name. The redirect URI is
# derived from POTION_APP_URL unless pinned here, and Google matches it
# EXACTLY — the boot log prints the resolved value; register that string.
POTION_GOOGLE_CLIENT_ID=
POTION_GOOGLE_CLIENT_SECRET=
POTION_GOOGLE_REDIRECT_URI=
# Generic OIDC (enterprise SSO). All four or nothing.
POTION_OIDC_ISSUER=
POTION_OIDC_CLIENT_ID=
POTION_OIDC_CLIENT_SECRET=
POTION_OIDC_REDIRECT_URI=
# Demo tenant credential. org_demo is always seeded (it is undeletable by
# design) but carries NO usable key unless this is 1 — G2.4.
POTION_SEED_DEMO=

# ---- Serving behaviour -----------------------------------------------------
# The price table serving reads. MUST be the table the committed baseline
# frontiers were measured against, or routing 503s on a version mismatch.
POTION_PRICES_PATH=
# Per-request provider timeout, ms. Default 60000.
POTION_PROVIDER_TIMEOUT_MS=
# Reasoning models known at boot (comma-separated aliases): below a 1024-token
# output budget they are skipped before the call. The server also learns them.
POTION_REASONING_MODELS=
# Cluster assignment cache (P0-2). Defaults: 10000 entries, 1h TTL. Both are
# clamped — a typo cannot make the cache unbounded.
POTION_ASSIGN_CACHE_MAX=
POTION_ASSIGN_CACHE_TTL_MS=
# Ambiguity margin for cluster assignment. Default is tuned with the embedder.
POTION_CLUSTER_AMBIGUITY=

# ---- Demand learning -------------------------------------------------------
# Aggregated cross-org demand signal. `0` disables it entirely; the minimums
# are the k-anonymity floor below which nothing is recorded.
POTION_DEMAND_LEARNING=
POTION_DEMAND_MIN_ORGS=
POTION_DEMAND_MIN_REQUESTS=
POTION_DEMAND_FLUSH_MS=

# ---- The research programme (SPENDS MONEY) ---------------------------------
# `live` makes cycles/evals/rubric generation call REAL providers with real
# spend. Anything else is the mock path. Three separate switches on purpose:
# arming evaluation is not arming rubric authorship.
POTION_RESEARCH_PROVIDER=
POTION_EVAL_PROVIDER=
POTION_RUBRIC_PROVIDER=
# Program synthesis (docs/INFERENCE-COMPILER-PLAN.md C2). OFF unless armed:
# every armed cycle spends money measuring synthesized programs.
POTION_SYNTH_PROGRAMS=
# Promotion gate thresholds (SPEC §15.4). Defaults +1.5pts / 20% / 1.5pts.
# The last is the cost path's NON-INFERIORITY MARGIN — how much measured
# quality a cost cut may buy. 0 is accepted and means "no regression at all",
# which has no power at any sample size, so the cost path then never fires.
POTION_RESEARCH_QUALITY_DELTA_MIN=
POTION_RESEARCH_COST_CUT_MIN=
POTION_RESEARCH_COST_QUALITY_MARGIN=
# Autonomous learning budget, USD. Both default to 0 = the loop spends nothing.
POTION_AUTONOMOUS_LEARNING_DAILY_USD=
POTION_AUTONOMOUS_LEARNING_PER_RUN_USD=
POTION_LEARNING_PRIORITY_WEIGHT=
# Suite directory override for synthesized agent replay suites.
POTION_SUITES_V2_DIR=
# Minimum quality a recipe must reach to appear on the public leaderboard.
POTION_LEADERBOARD_QUALITY_MIN=

# ---- The research fleet (docs/RESEARCH-OPS.md) -----------------------------
# The Observatory's standing programme. POTION_OBSERVATORY_ARM is a DATE: the
# operator's grant, without which the weekly chain does not run.
POTION_OBSERVATORY_ARM=
POTION_RESEARCH_DIR=
POTION_RESEARCH_ORG=
POTION_RESEARCH_DELTA_HARNESS=
POTION_RESEARCH_DELTA_DAILY_HARNESS=
POTION_RESEARCH_AUDITOR_HARNESS=
POTION_RESEARCH_AUDITOR_DAILY_HARNESS=

# ---- The Lab's hands -------------------------------------------------------
# X1/X6: the code sandbox and the browser. Internal-network URLs. Unset
# disables the superpower with a TYPED note in the run, never a crash.
POTION_SANDBOX_URL=
POTION_BROWSER_URL=
# The clock: `0` stops armed standing missions from running themselves.
POTION_LAB_SCHEDULER=
# BYO-MCP: `1` lets a connector row override a registry endpoint.
POTION_CONNECTOR_ENDPOINT_OVERRIDES=

# ---- Notifications ---------------------------------------------------------
# `0` silences every digest and alert email. Support form destination falls
# back to a compiled-in address when unset.
POTION_NOTIFY=
POTION_SUPPORT_EMAIL=

# ---- Dashboard (its own process) -------------------------------------------
# Where the dashboard reaches the API: POTION_API_URL server-side,
# POTION_PUBLIC_API_URL / POTION_API_URL_PUBLIC for strings shown to a user.
# POTION_DASHBOARD_URL is the reverse — where the SERVER links back to.
POTION_API_URL=
POTION_PUBLIC_API_URL=
POTION_API_URL_PUBLIC=
POTION_DASHBOARD_URL=
# The docs "ask" box calls Potion through Potion. Its own key, its own cap.
POTION_SELF_KEY=
DOCS_ASK_DAILY_MAX=
# Where the dashboard reads published Frontier Notes from.
FRONTIER_NOTES_DIR=

# ---- Observability + database pool -----------------------------------------
# OTel is fully off (lazy import, no-op) unless an endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
POTION_LOG_LEVEL=
PG_IDLE_TIMEOUT_MS=
