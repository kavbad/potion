# Potion deployment environment — NAMES AND GENERATION COMMANDS ONLY.
#
# Copy to .env.prod, fill in, then: chown root .env.prod && chmod 600 .env.prod
# .env* is gitignored. NEVER commit a filled copy, and never bake these into
# the image — they are supplied at run time via `--env-file`.

# ---- Front door ------------------------------------------------------------
# Hostname in production (Caddy auto-provisions TLS). Use `:443` for the local
# rehearsal, where Caddy issues an internal self-signed cert instead.
POTION_SITE=potion.example.com

# ---- Database --------------------------------------------------------------
# MUST be PostgreSQL >= 15 WITH pgvector:
#   · migration 0023 uses `NULLS NOT DISTINCT`  → PG15+ only
#   · migration 0000 does `CREATE EXTENSION vector` → pgvector + a user
#     privileged enough to create it
# Verify BOTH before the first boot (docs/DEPLOY-RUNBOOK.md preflight).
POSTGRES_USER=potion
POSTGRES_PASSWORD=          # openssl rand -base64 32
POSTGRES_DB=potion

# ---- Secrets ---------------------------------------------------------------
# Encrypts stored BYOK provider keys. IF THIS IS LOST, EVERY STORED PROVIDER
# KEY IS UNRECOVERABLE. Back it up SEPARATELY from database dumps — a dump
# plus this key together is full custody compromise.
#   openssl rand -hex 32
POTION_MASTER_KEY=

# Guards the /operator/* surface. FAIL-CLOSED: unset ⇒ every operator call
# 401s and no partner org can be created. Compared timing-safely.
#   openssl rand -hex 32
POTION_OPERATOR_TOKEN=

# ---- Embedder + clustering -------------------------------------------------
# G0.5 TRAP: the default clustering threshold (0.62) is MOCK-TUNED. With a real
# embedder it must be 0.2 or agent clustering silently misbehaves — the
# walkthrough prints this warning on every run.
POTION_EMBEDDER=openai
POTION_CLUSTER_THRESHOLD=0.2

# ---- Provider keys ---------------------------------------------------------
# Partner BYOK (stored encrypted, per-org) is preferred. Platform-level keys
# below are only for platform work (research cycles, calibration).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ---- Observability ---------------------------------------------------------
# 1 = /metrics exists (blocked at the public listener by deploy/Caddyfile).
# 0 = the meter and the route do not exist at all — prefer this until a
#     scraper is actually deployed.
POTION_METRICS=0

# ---- Deliberately NOT set --------------------------------------------------
# POTION_SELF_SERVE — must stay unset. Operator onboarding
#   (docs/ONBOARDING-RUNBOOK.md) is the only way a partner org comes into
#   being; unknown emails get a neutral response and no org.
