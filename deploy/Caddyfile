# Potion single-instance TLS front door — TWO vhosts (deploy plan D2).
#
# api.<domain>  → apps/server   (SDK traffic: Bearer keys, /v1 + server /api)
# app.<domain>  → apps/dashboard (browser traffic: session cookie; the
#                dashboard's own /api/* route handlers proxy to the server
#                over the compose network, cookie attached)
#
# The split is load-bearing, not cosmetic: the two /api/* namespaces are
# DIFFERENT SURFACES (Bearer-authed Fastify vs cookie-proxying Next), and
# path-routing one hostname would interleave them.
{$POTION_API_SITE} {
	encode gzip

	# /metrics is classified `public` in apps/server/src/security/route-inventory.ts
	# with the justification "the surface is network-restricted by deployment
	# posture". THIS BLOCK IS THAT POSTURE. Without it the justification is a
	# phantom decision — a comment asserting a protection nothing enforces.
	@metrics path /metrics /metrics/*
	respond @metrics "not available on the public listener" 403

	reverse_proxy server:3000 {
		health_uri /readyz
		health_interval 10s
	}
}

# The APEX is the canonical host (2026-08-26, SEO/AEO cutover): content
# authority, citations, and cookies all consolidate on the bare domain.
# www joins it here rather than redirecting so both stay warm; Caddy holds
# certs for both. api.<domain> is untouched — API subdomains are correct.
{$POTION_ROOT_SITE}, www.{$POTION_ROOT_SITE} {
	encode gzip
	reverse_proxy dashboard:3001
}

# app.<domain>: the FORMER canonical host. Path-preserving permanent
# redirect so every link, bookmark, and page indexed before the cutover
# lands on its apex twin — never on a landing page that threw the path
# away (the exact failure this cutover retires).
{$POTION_APP_SITE} {
	redir https://{$POTION_ROOT_SITE}{uri} permanent
}
