{"id": "creative-002", "clusterId": "creative", "prompt": [{"role": "user", "content": "Invent five name candidates for a fictional startup that makes modular balcony gardening kits. Names must be one or two words, easy to spell after hearing once, and must not contain the word 'garden' or 'green'. For each name, give a one-sentence rationale."}], "scoring": {"kind": "llm-judge", "rubric": "Criteria: (1) exactly five names; (2) each 1-2 words, pronounceable/spellable; (3) none use 'garden' or 'green'; (4) names feel brandable and distinct from one another (not five near-synonyms); (5) each has a one-sentence rationale tied to the product. General scale: 10 = fully meets every stated constraint with flair and polish; 7-9 = meets constraints, minor lapses in craft; 4-6 = misses one explicit constraint or is generic/flat; 1-3 = misses multiple constraints; 0 = ignores the prompt or is incoherent.", "judgeModel": "judge-class", "scale": [0, 10]}}
{"id": "creative-003", "clusterId": "creative", "prompt": [{"role": "user", "content": "Write a 14-line sonnet about a tide clock that has stopped working. It should roughly follow an ABAB CDCD EFEF GG rhyme scheme and end on a turn about patience."}], "scoring": {"kind": "llm-judge", "rubric": "Criteria: (1) 14 lines; (2) approximately the requested rhyme scheme (slant rhyme acceptable); (3) subject is a stopped tide clock; (4) final couplet delivers a turn about patience; (5) imagery is fresh, meter roughly iambic pentameter. General scale: 10 = fully meets every stated constraint with flair and polish; 7-9 = meets constraints, minor lapses in craft; 4-6 = misses one explicit constraint or is generic/flat; 1-3 = misses multiple constraints; 0 = ignores the prompt or is incoherent.", "judgeModel": "judge-class", "scale": [0, 10]}}
{"id": "creative-004", "clusterId": "creative", "prompt": [{"role": "user", "content": "Write three alternative taglines (max 8 words each) for a fictional app called 'Mossback' that helps people remember to water houseplants. Each tagline should take a different angle: one playful, one practical, one emotional."}], "scoring": {"kind": "llm-judge", "rubric": "Criteria: (1) exactly three taglines, each <= 8 words; (2) clearly three different angles (playful, practical, emotional); (3) mentions or evokes plant care; (4) taglines are punchy, not generic slogans like 'the best app for you'. General scale: 10 = fully meets every stated constraint with flair and polish; 7-9 = meets constraints, minor lapses in craft; 4-6 = misses one explicit constraint or is generic/flat; 1-3 = misses multiple constraints; 0 = ignores the prompt or is incoherent.", "judgeModel": "judge-class", "scale": [0, 10]}}
{"id": "creative-005", "clusterId": "creative", "prompt": [{"role": "user", "content": "Write a short dialogue scene (10-14 lines of dialogue, minimal stage directions) between a locksmith and a customer who has locked their keys inside a bakery overnight. The locksmith should gradually realize the customer actually owns the bakery and just forgot. No shouting, no slapstick."}], "scoring": {"kind": "llm-judge", "rubric": "Criteria: (1) 10-14 dialogue lines; (2) the realization emerges gradually through subtext, not stated outright early; (3) tone is grounded, no shouting/slapstick; (4) characters have distinct voices; (5) scene has a satisfying small arc. General scale: 10 = fully meets every stated constraint with flair and polish; 7-9 = meets constraints, minor lapses in craft; 4-6 = misses one explicit constraint or is generic/flat; 1-3 = misses multiple constraints; 0 = ignores the prompt or is incoherent.", "judgeModel": "judge-class", "scale": [0, 10]}}
{"id": "creative-006", "clusterId": "creative", "prompt": [{"role": "user", "content": "Write a two-sentence horror story. It must be genuinely unsettling, involve an ordinary household object, and contain no gore."}], "scoring": {"kind": "llm-judge", "rubric": "Criteria: (1) exactly two sentences; (2) centers on an ordinary household object; (3) unsettling through implication rather than gore; (4) the twist lands in the second sentence; (5) not a retread of famous two-sentence horror tropes (e.g., 'knock knock, I was the last one alive'). General scale: 10 = fully meets every stated constraint with flair and polish; 7-9 = meets constraints, minor lapses in craft; 4-6 = misses one explicit constraint or is generic/flat; 1-3 = misses multiple constraints; 0 = ignores the prompt or is incoherent.", "judgeModel": "judge-class", "scale": [0, 10]}}
