    "@potion/providers": "workspace:*",
    "@potion/strategies": "workspace:*",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "vitest": "^2.0.5",
    "typescript": "^5.5.4"
  }
