{
  "name": "@potion/db",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "inspect-attribution": "tsx src/inspect-attribution.ts",
    "rehearse-postgres": "tsx src/rehearse-postgres.ts"
  },
  "dependencies": {
    "@potion/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "@electric-sql/pglite": "^0.5.8"
  },
  "peerDependencies": {
    "pg": "^8.13.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/node": "^20.14.0",
    "vitest": "^2.0.5",
    "typescript": "^5.5.4"
  }
}
