{
  "name": "potion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test && pnpm test:scripts",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:scripts",
    "lint": "eslint .",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "demo:mock-e2e": "tsx scripts/demo-mock-e2e.ts",
    "demo:customer": "tsx scripts/demo-customer.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "m1b:sweep": "tsx scripts/m1b-sweep.ts",
    "harness": "tsx packages/harness/src/cli.ts",
    "test:scripts": "vitest run scripts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "devDependencies": {
    "@potion/cluster": "workspace:*",
    "@potion/core": "workspace:*",
    "@potion/custody": "workspace:*",
    "@potion/db": "workspace:*",
    "@potion/harness": "workspace:*",
    "@potion/lab-dial": "workspace:*",
    "@potion/lab-mcp": "workspace:*",
    "@potion/lab-runtime": "workspace:*",
    "@potion/lab-spec": "workspace:*",
    "@potion/lab-superpowers": "workspace:*",
    "@potion/observability": "workspace:*",
    "@potion/pareto": "workspace:*",
    "@potion/providers": "workspace:*",
    "@potion/queue": "workspace:*",
    "@potion/researcher": "workspace:*",
    "@potion/server": "workspace:*",
    "@potion/strategies": "workspace:*",
    "@potion/workers": "workspace:*",
    "@types/node": "^20.14.0",
    "eslint": "^9.8.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "8.65.0",
    "vitest": "^2.0.5"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@3.1.5": "^3.1.6",
      "fast-uri@4.1.2": "^4.1.3",
      "glob@10.4.5": "^10.5.0",
      "nanoid@3.3.17": "^3.3.18",
      "postcss@8.4.31": "^8.5.18",
      "sharp@0.34.5": "^0.35.0"
    }
  }
}
